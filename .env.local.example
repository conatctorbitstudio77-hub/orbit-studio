# Supabase project settings — Settings → API in the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key — server-only, never exposed to the browser. Keep secret.
SUPABASE_SERVICE_ROLE_KEY=

# Resend — resend.com/api-keys
RESEND_API_KEY=

# Where new-quote notifications are sent, and the "from" address Resend sends as
# (must be on a domain verified in Resend before going live).
ADMIN_NOTIFICATION_EMAIL=
ADMIN_FROM_EMAIL=
