# Supabase — Settings → API in your Supabase project
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only — bypasses Row Level Security. Never expose to the client
# or commit a real value. Do not prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Resend — API Keys in your Resend account
RESEND_API_KEY=
# Where new-quote/booking alerts land
ADMIN_NOTIFICATION_EMAIL=
# Must be an address on a domain verified in Resend
ADMIN_FROM_EMAIL=
